---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for group in site.data.sivustokartta -%}
{% for translation in group -%}
  <url>
    <loc>{{ translation[1].path | absolute_url | xml_escape }}</loc>
    <lastmod>{{ translation[1].lastmod }}</lastmod>
    {% for alternate in group -%}
    <xhtml:link rel="alternate" hreflang="{{ alternate[0] }}" href="{{ alternate[1].path | absolute_url | xml_escape }}" />
    {% endfor -%}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ group.fi.path | absolute_url | xml_escape }}" />
  </url>
{% endfor -%}
{% endfor -%}
{% assign articles = site.pages | where: "layout", "sisalto" | sort: "url" %}
{% for article in articles %}
  <url><loc>{{ article.permalink | absolute_url | xml_escape }}</loc><lastmod>{{ article.lastmod }}</lastmod></url>
{% endfor %}
{% comment %}HallaTalent v7f (28.11.2026): HallaTalent-sivut (product: HallaTalent), etusivu ja 13 alasivua.{% endcomment %}
{% assign talent_sivut = site.pages | where: "product", "HallaTalent" | sort: "url" %}
{% for sivu in talent_sivut %}
  <url><loc>{{ sivu.url | absolute_url | xml_escape }}</loc><lastmod>{{ sivu.lastmod }}</lastmod></url>
{% endfor %}
</urlset>
